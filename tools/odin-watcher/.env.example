TOC_BASE_URL=https://thor-operations-command-app.vercel.app
ODIN_API_KEY=

# Local Odin/OpenClaw gateway on the AI PC. Keep these only on the AI PC.
OPENCLAW_LOCAL_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=openclaw/default
OPENCLAW_SESSION_KEY=toc:watcher

# Safety controls
ODIN_DRY_RUN=true
ODIN_MIN_SEVERITY=amber
ODIN_DUPLICATE_WINDOW_HOURS=24
ODIN_STALE_LOCK_MINUTES=30
